# Copy this file to .env.local and fill in the real values there.
# .env.local is git-ignored — env.example is the committed template and must
# never contain real secrets.
#
# Leave all four DYNAMICS_* vars unset to run against a built-in mock F&O/Dataverse
# environment (src/lib/dynamics/mock.ts) — the dashboard works immediately with no
# credentials at all.
#
# Set all four to point the same code at a real environment instead: an Azure AD
# app registration, granted API access and an application user with a security
# role in the target Dataverse/F&O environment.
DYNAMICS_TENANT_ID=""
DYNAMICS_CLIENT_ID=""
DYNAMICS_CLIENT_SECRET=""
DYNAMICS_RESOURCE_URL="https://your-org.crm.dynamics.com"

# Optional: checked against the Authorization header on /api/dynamics/sync.
# Leave unset in local dev to call it without a token.
CRON_SECRET=""
